<Window x:Class="MacKeys.UI.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource MacWindow}"
        Title="Relatar um problema" Width="636" Height="640"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Two-option segmented control, like macOS. -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="5" Padding="16,4" Margin="2" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Control}" />
                                <Setter TargetName="Bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.18" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="Margin" Value="2,14,0,6" />
        </Style>
    </Window.Resources>

    <ContentControl Style="{StaticResource MacFrame}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="Drag">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource TrafficLight}" Background="{DynamicResource Traffic.Close}"
                            Content="×" ToolTip="Fechar" Click="Cancel_Click" />
                    <Button Style="{StaticResource TrafficLight}" Background="{DynamicResource Traffic.Minimize}"
                            Content="−" ToolTip="Minimizar" Click="Minimize_Click" />
                    <Button Style="{StaticResource TrafficLight}" Background="{DynamicResource Traffic.Idle}" IsHitTestVisible="False" />
                </StackPanel>
                <TextBlock Text="Relatar um problema" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,6,28,8">
                    <Border x:Name="CrashNotice" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="26" Height="26" CornerRadius="13" Background="#FF9F0A" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="!" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Style="{StaticResource Secondary}" VerticalAlignment="Center" MaxWidth="480"
                                       Text="O MacKeys registrou um erro inesperado. Os detalhes dele já estão nas informações técnicas abaixo." />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource Switch.Off}" CornerRadius="7" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ProblemChoice" Style="{StaticResource Segment}" GroupName="Kind" IsChecked="True"
                                         Content="Problema" Checked="Kind_Changed" />
                            <RadioButton x:Name="IdeaChoice" Style="{StaticResource Segment}" GroupName="Kind"
                                         Content="Sugestão" Checked="Kind_Changed" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Label}" Text="Título" />
                    <Border Style="{StaticResource Card}">
                        <TextBox x:Name="TitleBox" Style="{StaticResource Field}" TextChanged="Text_Changed" />
                    </Border>

                    <TextBlock x:Name="DescriptionLabel" Style="{StaticResource Label}" Text="O que aconteceu?" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <TextBox x:Name="DescriptionBox" Style="{StaticResource Field}" Height="120" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Text_Changed" />
                            <TextBlock x:Name="DescriptionHint" Style="{StaticResource Secondary}" Margin="12,8" IsHitTestVisible="False"
                                       Foreground="{DynamicResource Text.Tertiary}"
                                       Text="Em qual app você estava, o que fez, o que esperava e o que aconteceu." />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid Margin="14,11">
                                <StackPanel Margin="0,0,56,0">
                                    <TextBlock Text="Incluir informações técnicas" />
                                    <TextBlock Style="{StaticResource Secondary}"
                                               Text="Versões, Windows, teclado, suas opções do MacKeys, PowerToys e o fim do log. Seu nome e suas pastas são trocados por reticências." />
                                </StackPanel>
                                <CheckBox x:Name="TechnicalSwitch" Style="{StaticResource MacSwitch}" HorizontalAlignment="Right"
                                          IsChecked="True" Click="Technical_Click" />
                            </Grid>
                            <Border Style="{StaticResource RowSeparator}" />
                            <Expander x:Name="TechnicalExpander" Margin="14,8,14,10" Foreground="{DynamicResource Accent}"
                                      Header="Ver o que será enviado">
                                <TextBox x:Name="TechnicalBox" IsReadOnly="True" Margin="0,8,0,0" Height="150"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="8"
                                         Background="{DynamicResource Bg.Window}" Foreground="{DynamicResource Text.Secondary}" />
                            </Expander>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Secondary}" Margin="2,12,0,0"
                               Text="“Abrir no GitHub” cria uma página pública com este relatório (precisa de uma conta no GitHub). Sem conta, use “Copiar” e mande por mensagem. Nada do que você digita nos apps é incluído." />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="28,12,28,22">
                <TextBlock x:Name="CopiedText" Style="{StaticResource Secondary}" VerticalAlignment="Center"
                           Text="Copiado." Visibility="Hidden" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MacButton}" Content="Cancelar" MinWidth="90" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button x:Name="CopyButton" Style="{StaticResource MacButton}" Content="Copiar" MinWidth="90" Margin="0,0,8,0"
                            Click="Copy_Click" />
                    <Button x:Name="SendButton" Style="{StaticResource PrimaryButton}" Content="Abrir no GitHub" MinWidth="130"
                            Click="Send_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </ContentControl>
</Window>
