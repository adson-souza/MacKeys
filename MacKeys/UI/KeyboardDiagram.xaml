<UserControl x:Class="MacKeys.UI.KeyboardDiagram"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The bottom-left of a PC keyboard, with the Mac meaning of each key underneath. -->
    <UserControl.Resources>
        <Style x:Key="Key" TargetType="Border">
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1,1,1,3" />
            <Setter Property="Background" Value="{DynamicResource Bg.KeyCap}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.KeyCap}" />
        </Style>
        <Style x:Key="HotKey" TargetType="Border" BasedOn="{StaticResource Key}">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent.Pressed}" />
        </Style>
        <Style x:Key="PcLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="8,6,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="MacGlyph" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="0,0,8,4" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        </Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="170" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Key}" Grid.Column="0">
            <Grid>
                <TextBlock Style="{StaticResource PcLabel}" Text="Ctrl" Foreground="{DynamicResource Text.Secondary}" />
                <TextBlock Style="{StaticResource MacGlyph}" Text="⌃" Foreground="{DynamicResource Text.Primary}" />
            </Grid>
        </Border>
        <Border Style="{StaticResource HotKey}" Grid.Column="1">
            <Grid>
                <TextBlock Style="{StaticResource PcLabel}" Text="Win" Foreground="#CCFFFFFF" />
                <TextBlock Style="{StaticResource MacGlyph}" Text="⌥" Foreground="White" />
            </Grid>
        </Border>
        <Border Style="{StaticResource HotKey}" Grid.Column="2">
            <Grid>
                <TextBlock Style="{StaticResource PcLabel}" Text="Alt" Foreground="#CCFFFFFF" />
                <TextBlock Style="{StaticResource MacGlyph}" Text="⌘" Foreground="White" />
            </Grid>
        </Border>
        <Border Style="{StaticResource Key}" Grid.Column="3">
            <TextBlock Text="espaço" FontSize="11" Foreground="{DynamicResource Text.Secondary}"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
        </Border>

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Caption}" Text="control" />
        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Caption}" Text="option" />
        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Caption}" Text="command" />
    </Grid>
</UserControl>
