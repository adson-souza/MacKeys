<Window x:Class="MacKeys.UI.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MacKeys.UI"
        Style="{StaticResource MacWindow}"
        Title="Bem-vindo ao MacKeys" Width="600" Height="580"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Fill" Value="{DynamicResource Text.Tertiary}" />
        </Style>
        <Style x:Key="Tip" TargetType="Grid">
            <Setter Property="Margin" Value="14,8" />
        </Style>
    </Window.Resources>

    <ContentControl Style="{StaticResource MacFrame}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="18,16,0,0" Background="Transparent" MouseLeftButtonDown="Drag">
                <Button Style="{StaticResource TrafficLight}" Background="{DynamicResource Traffic.Close}"
                        Content="×" ToolTip="Fechar" Click="Close_Click" />
                <Button Style="{StaticResource TrafficLight}" Background="{DynamicResource Traffic.Idle}" IsHitTestVisible="False" />
                <Button Style="{StaticResource TrafficLight}" Background="{DynamicResource Traffic.Idle}" IsHitTestVisible="False" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="44,8,44,0" Background="Transparent" MouseLeftButtonDown="Drag">

                <!-- 1. Welcome -->
                <StackPanel x:Name="Step1" VerticalAlignment="Center">
                    <Image x:Name="HeroIcon" Width="104" Height="104" />
                    <TextBlock Style="{StaticResource Title}" FontSize="26" Text="Bem-vindo ao MacKeys"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Style="{StaticResource Secondary}" FontSize="14" TextAlignment="Center" Margin="0,6,0,26"
                               Text="Seus atalhos do Mac, no teclado do Windows." />
                    <ui:KeyboardDiagram />
                    <TextBlock Style="{StaticResource Secondary}" TextAlignment="Center" Margin="0,16,0,0"
                               Text="O Alt vira ⌘ e o Win vira ⌥, exatamente onde seus dedos já procuram. O AltGr continua igual." />
                </StackPanel>

                <!-- 2. Try it -->
                <StackPanel x:Name="Step2" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Title}" FontSize="26" Text="Experimente" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Secondary}" FontSize="14" TextAlignment="Center" Margin="0,6,0,18"
                               Text="Use os atalhos de sempre no texto abaixo." />
                    <Border Style="{StaticResource Card}" Padding="2">
                        <TextBox x:Name="PracticeBox" Height="74" Padding="10,8" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource Text.Primary}" CaretBrush="{DynamicResource Accent}"
                                 FontSize="14" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="O MacKeys deixa o Windows com cara de Mac. Selecione, copie, cole e desfaça à vontade." />
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="0,6">
                        <StackPanel>
                            <Grid Style="{StaticResource Tip}">
                                <ui:KeyCaps Keys="⌘ A" />
                                <TextBlock Text="Selecionar tudo" Margin="130,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Style="{StaticResource Tip}">
                                <ui:KeyCaps Keys="⌘ C · ⌘ V" />
                                <TextBlock Text="Copiar e colar" Margin="130,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Style="{StaticResource Tip}">
                                <ui:KeyCaps Keys="⌘ ← →" />
                                <TextBlock Text="Ir ao início ou ao fim da linha" Margin="130,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Style="{StaticResource Tip}">
                                <ui:KeyCaps Keys="⌥ ← →" />
                                <TextBlock Text="Pular palavras" Margin="130,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Style="{StaticResource Tip}">
                                <ui:KeyCaps Keys="⌘ Z" />
                                <TextBlock Text="Desfazer" Margin="130,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3. Done -->
                <StackPanel x:Name="Step3" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Title}" FontSize="26" Text="Tudo pronto" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Secondary}" FontSize="14" TextAlignment="Center" Margin="0,6,0,22"
                               Text="Só mais duas escolhas." />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="14,12">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Iniciar com o Windows" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Para os atalhos estarem sempre prontos." />
                                </StackPanel>
                                <CheckBox x:Name="StartupSwitch" Style="{StaticResource MacSwitch}" HorizontalAlignment="Right" IsChecked="True" />
                            </Grid>
                            <Border Style="{StaticResource RowSeparator}" />
                            <Grid Margin="14,12">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Cola de atalhos" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Segure ⌘ por um segundo para ver os atalhos do app aberto." />
                                </StackPanel>
                                <CheckBox x:Name="CheatSheetSwitch" Style="{StaticResource MacSwitch}" HorizontalAlignment="Right" IsChecked="True" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14,12">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource Bg.KeyCap}" Margin="0,0,12,0">
                                <TextBlock Text="⌘" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Style="{StaticResource Secondary}" VerticalAlignment="Center" MaxWidth="400"
                                       Text="O MacKeys fica na bandeja, perto do relógio. Clique no ⌘ para pausar ou abrir as configurações." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="28,0,28,24">
                <Button x:Name="BackButton" Style="{StaticResource MacButton}" Content="Voltar"
                        HorizontalAlignment="Left" Visibility="Hidden" Click="Back_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot1" Style="{StaticResource Dot}" />
                    <Ellipse x:Name="Dot2" Style="{StaticResource Dot}" />
                    <Ellipse x:Name="Dot3" Style="{StaticResource Dot}" />
                </StackPanel>
                <Button x:Name="NextButton" Style="{StaticResource PrimaryButton}" Content="Continuar"
                        HorizontalAlignment="Right" MinWidth="100" Click="Next_Click" />
            </Grid>
        </Grid>
    </ContentControl>
</Window>
