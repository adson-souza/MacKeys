<Window x:Class="MacKeys.UI.AddAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource MacWindow}"
        Title="Adicionar app" Width="460" Height="520"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <ContentControl Style="{StaticResource MacFrame}">
        <DockPanel Margin="20,18,20,18">
            <StackPanel DockPanel.Dock="Top" Background="Transparent" MouseLeftButtonDown="Drag">
                <TextBlock Text="Adicionar app" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,12"
                           Text="Escolha um dos apps abertos agora, ou procure o arquivo .exe." />
            </StackPanel>

            <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Button Style="{StaticResource MacButton}" Content="Procurar .exe…" HorizontalAlignment="Left" Click="Browse_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MacButton}" Content="Cancelar" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button x:Name="AddButton" Style="{StaticResource PrimaryButton}" Content="Adicionar"
                            IsEnabled="False" Click="Add_Click" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="4">
                <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource SidebarItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="AppList_SelectionChanged"
                         MouseDoubleClick="AppList_MouseDoubleClick" />
            </Border>
        </DockPanel>
    </ContentControl>
</Window>
