<Window x:Class="MacKeys.UI.CheatSheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource MacWindow}"
        Title="Atalhos" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" Focusable="False">
    <ContentControl Style="{StaticResource MacFrame}" Background="{DynamicResource Bg.Overlay}">
        <StackPanel Margin="26,22,26,18">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ContentControl x:Name="AppIconHost" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="AppName" FontSize="17" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Border CornerRadius="4" Padding="6,1" Background="{DynamicResource Accent}">
                            <TextBlock x:Name="ProfileName" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                        <TextBlock x:Name="ProfileHint" Style="{StaticResource Secondary}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" MaxWidth="520" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <WrapPanel x:Name="Columns" Orientation="Horizontal" MaxWidth="900" />

            <TextBlock Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,14,0,0"
                       Text="Solte ⌘ para fechar · Desligue em Configurações › Geral" />
        </StackPanel>
    </ContentControl>
</Window>
