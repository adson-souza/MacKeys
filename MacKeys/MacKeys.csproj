<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 target gives access to Windows.Data.Pdf, used by Quick Look to render PDF and .ai pages. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only for NotifyIcon (WPF has no tray icon) and the Keys enum used by the hooks. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MacKeys</AssemblyName>
    <RootNamespace>MacKeys</RootNamespace>
    <Version>0.4.0</Version>
    <InformationalVersion>0.4.0 (teste)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\MacKeys.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WinForms analyzer wants DPI set in code; this is a WPF app, which reads it from the manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WinForms/GDI names out of the global scope so they don't clash with WPF's. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.Windows.Forms.Keys" Alias="Keys" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\MacKeys.ico" />
  </ItemGroup>

</Project>
