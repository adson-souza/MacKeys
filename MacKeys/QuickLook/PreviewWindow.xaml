<Window x:Class="MacKeys.QuickLook.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pré-visualização"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" MinWidth="420" MinHeight="260"
        Background="{DynamicResource Bg.Window}"
        FontFamily="{StaticResource MacFont}" FontSize="13" Foreground="{DynamicResource Text.Primary}"
        UseLayoutRounding="True">
    <!-- No AllowsTransparency here: layered windows can't show the native preview handlers (PDF, Office).
         Rounded corners and the shadow come from Windows 11 itself. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="5" Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="16" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Background="{DynamicResource Bg.Window}">
        <Grid DockPanel.Dock="Top" Height="48" Background="{DynamicResource Bg.Sidebar}"
              MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,12,0">
                <Button Style="{StaticResource TrafficLight}" Background="{DynamicResource Traffic.Close}"
                        Content="×" ToolTip="Fechar (Espaço)" Click="Close_Click" />
                <Button Style="{StaticResource TrafficLight}" Background="{DynamicResource Traffic.Idle}" IsHitTestVisible="False" />
                <Button Style="{StaticResource TrafficLight}" Background="{DynamicResource Traffic.Zoom}"
                        Content="+" ToolTip="Tela cheia" Click="Zoom_Click" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="{DynamicResource Text.Secondary}"
                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <StackPanel x:Name="NavPanel" Orientation="Horizontal" Margin="0,0,10,0" Visibility="Collapsed">
                    <Button Style="{StaticResource NavButton}" Content="‹" ToolTip="Anterior" Click="Previous_Click" />
                    <TextBlock x:Name="CounterText" FontSize="12" Foreground="{DynamicResource Text.Secondary}"
                               VerticalAlignment="Center" Margin="4,0" />
                    <Button Style="{StaticResource NavButton}" Content="›" ToolTip="Próximo" Click="Next_Click" />
                </StackPanel>
                <Button x:Name="OpenButton" Style="{StaticResource MacButton}" Padding="12,4" Click="Open_Click" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Separator}" />

        <Grid x:Name="Body" ClipToBounds="True" />
    </DockPanel>
</Window>
